/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Full test configuration (3 complete reference bacterial genomes)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    input         = "${projectDir}/assets/samplesheet.csv"
    outdir        = 'results'
    bakta_db_dir  = "${launchDir}/.janus/bakta"
    eggnog_db_dir = "${launchDir}/.janus/eggnog"
}

process {
    resourceLimits = [
        cpus:   4,
        memory: 8.GB,
        time:   6.h
    ]
}
