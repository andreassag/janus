/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Test configuration (compact 2-sample bacterial dataset)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    input         = "${projectDir}/assets/samplesheet_test.csv"
    outdir        = 'results'
    bakta_db_type = 'light'
    bakta_db_dir  = "${launchDir}/.janus/bakta"
    eggnog_db_dir = "${launchDir}/.janus/eggnog"
}

process {
    resourceLimits = [
        cpus:   2,
        memory: 6.GB,
        time:   2.h
    ]
}
